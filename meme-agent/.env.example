# ── Trading mode ─────────────────────────────────────────────────────────
# "paper" (default, safe, no real funds) or "live" (real on-chain swaps).
TRADING_MODE=paper

# Required ONLY when TRADING_MODE=live. Must be set to this exact string.
# This is a deliberate second gate so live trading can never start by
# accident just because TRADING_MODE got set to "live" somewhere.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# Required ONLY when TRADING_MODE=live. Base58-encoded secret key of a
# BURNER wallet you have funded with only what you're willing to lose.
# Never put your main wallet's key here.
# WALLET_PRIVATE_KEY=

# ── Network ──────────────────────────────────────────────────────────────
# Public RPC is rate-limited and unreliable for a live bot. Use a paid RPC
# (Helius, QuickNode, Triton, etc.) once you go beyond paper trading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://quote-api.jup.ag/v6
DEXSCREENER_API_BASE=https://api.dexscreener.com

# ── Paper trading ────────────────────────────────────────────────────────
PAPER_STARTING_SOL=10

# ── Loop timing (ms) ─────────────────────────────────────────────────────
SCAN_INTERVAL_MS=60000
POSITION_CHECK_INTERVAL_MS=15000

# ── Safety filters (all candidates must pass ALL of these) ──────────────
MIN_LIQUIDITY_USD=8000
MAX_TOKEN_AGE_MINUTES=720
MIN_VOLUME_5M_USD=2000
MAX_TOP_HOLDER_PCT=25
REQUIRE_MINT_AUTHORITY_RENOUNCED=true
REQUIRE_FREEZE_AUTHORITY_RENOUNCED=true

# ── Strategy / risk ──────────────────────────────────────────────────────
ENTRY_SCORE_THRESHOLD=70
MOMENTUM_WEIGHT=0.7
SENTIMENT_WEIGHT=0.3
MAX_POSITION_SOL=0.25
MAX_CONCURRENT_POSITIONS=5
STOP_LOSS_PCT=12
TAKE_PROFIT_PCT=35
TRAILING_STOP_PCT=15
DAILY_LOSS_LIMIT_SOL=1
SLIPPAGE_BPS=150

# ── Optional social sentiment (off by default; momentum-only otherwise) ──
# SENTIMENT_PROVIDER=lunarcrush
# LUNARCRUSH_API_KEY=
